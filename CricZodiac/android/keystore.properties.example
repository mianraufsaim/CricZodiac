# Copy this file to "keystore.properties" (same folder) and fill in your values.
# keystore.properties is gitignored — never commit it or the .jks file.
#
# storeFile is resolved relative to the android/app/ folder, so a keystore
# placed at android/upload-keystore.jks is referenced as ../upload-keystore.jks
storeFile=../upload-keystore.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=upload
keyPassword=YOUR_KEY_PASSWORD
